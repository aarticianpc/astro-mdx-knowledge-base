---
/**
 * Renders a JSON-LD <script> block.
 *
 * Strategy: the data passed in is the SAME object the page reads for visible
 * content (title, description, dates, author). This prevents drift between
 * structured data and what the user actually sees, because both render from
 * the same source.
 */
interface Props {
  data: Record<string, unknown>;
}
const { data } = Astro.props;
---
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(data)}
/>
