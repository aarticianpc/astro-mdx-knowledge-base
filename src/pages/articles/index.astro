---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const byCluster = new Map<string, typeof articles>();
for (const article of articles) {
  const cluster = article.data.cluster;
  const list = byCluster.get(cluster) ?? [];
  list.push(article);
  byCluster.set(cluster, list);
}
---
<BaseLayout
  title="All articles - Web Performance KB"
  description="Browse all long-form articles on Core Web Vitals, image optimization, caching, rendering, and JavaScript performance.">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight text-ink-900">All articles</h1>
    <p class="mt-2 text-ink-600">{articles.length} articles, organized by cluster.</p>

    {[...byCluster.entries()].map(([cluster, list]) => (
      <section class="mt-10">
        <h2 class="text-xl font-semibold text-ink-900 mb-4 capitalize">
          {cluster.replace(/-/g, ' ')}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {list.map((article) => <ArticleCard article={article} />)}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
