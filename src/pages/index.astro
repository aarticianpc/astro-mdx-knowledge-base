---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import JsonLd from '../components/JsonLd.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 6);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Web Performance Knowledge Base',
  url: siteUrl,
  description:
    'A research-backed reference for Core Web Vitals, image optimization, caching, rendering, and JavaScript performance.',
};
---
<BaseLayout
  title="Web Performance Knowledge Base"
  description="A research-backed reference for Core Web Vitals, image optimization, caching, rendering, and JavaScript performance.">
  <JsonLd slot="head" data={jsonLd} />

  <section class="max-w-3xl mx-auto px-4 pt-16 pb-12">
    <h1 class="text-5xl font-bold tracking-tight text-ink-900">
      Web Performance, <span class="text-accent-600">grounded in citations</span>.
    </h1>
    <p class="mt-5 text-lg text-ink-600 leading-relaxed">
      Long-form articles on the topics that move Core Web Vitals: rendering,
      images, caching, and JavaScript discipline. Every claim is cited, every
      citation is validated at build time.
    </p>
    <div class="mt-8 flex gap-3">
      <a
        href="/articles"
        class="inline-flex items-center gap-2 bg-accent-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-accent-500 transition-colors">
        Browse all articles
      </a>
      <a
        href="/about"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-medium text-ink-700 hover:bg-ink-100 transition-colors">
        About this site
      </a>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-20">
    <h2 class="text-xl font-semibold text-ink-900 mb-5">Latest articles</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
